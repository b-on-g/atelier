$bog_atelier_grimoire $mol_list
	rows /
		<= Intro $mol_text
			text <= intro @ \
				\Глиф состоит из трёх частей. **Кольцо** держит магию: пока оно разомкнуто, ничего не происходит, стоит замкнуть — чернила оживают. **Сигил** в центре выбирает стихию. **Знаки** по краю кольца говорят, куда и как она пойдёт.
				\
				\Формы и действие символов взяты из глав манги, номер главы указан в описании. Названия знаков придумали фанаты на вики: в самой манге их почти не называют.
		<= Spells_title $mol_paragraph
			title @ \Заклинания из манги
		<= Spells $mol_list
			rows <= spell_rows /
		<= Sigils_title $mol_paragraph
			title @ \Сигилы
		<= Sigils $mol_list
			rows <= sigil_rows /
		<= Signs_title $mol_paragraph
			title @ \Знаки
		<= Signs $mol_list
			rows <= sign_rows /
	Entry* $mol_view
		sub /
			<= Icon* $bog_atelier_icon
				entry_id <= entry_id* \
			<= Text* $mol_list
				rows /
					<= Name* $mol_view
						sub /
							<= Title* $mol_paragraph
								title <= entry_title* \
							<= Canon* $mol_paragraph
								title <= entry_canon* \
					<= Note* $mol_paragraph
						title <= entry_note* \
	Spell* $mol_link
		arg *
			screen \course
			lesson <= spell_id* \
		sub /
			<= Spell_preview* $bog_atelier_preview
				lines <= spell_lines* /
			<= Spell_text* $mol_list
				rows /
					<= Spell_name* $mol_view
						sub /
							<= Spell_title* $mol_paragraph
								title <= spell_title* \
							<= Spell_source* $mol_paragraph
								title <= spell_source* \
					<= Spell_note* $mol_paragraph
						title <= spell_note* \
	canon_manga @ \канон
	canon_fan @ \домысел
